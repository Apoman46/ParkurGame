<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ParkurGame"
        android:supportsRtl="true">

        <activity
            android:name=".MainMenuActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".GameActivity" android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".SettingsActivity" android:screenOrientation="landscape" />
        <activity android:name=".ShopActivity" android:screenOrientation="landscape" />
    </application>
</manifest>
